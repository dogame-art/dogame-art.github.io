# ============================================
# DOGAME NFT STORE - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# ============================================
# SOLANA CONFIGURATION
# ============================================

# Mint Authority Private Key (base58 encoded)
# This wallet signs NFT minting transactions
# Generate: solana-keygen new --outfile mint-authority.json
# Convert to base58: cat mint-authority.json | jq -r '.privateKey | @base64'
MINT_AUTHORITY_PRIVATE_KEY=your_base58_private_key_here

# Treasury Wallet Public Key (receives SOL payments)
# This is where customer payments are sent
# Example: 7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU
TREASURY_WALLET_PUBLIC_KEY=your_treasury_wallet_address_here

# Update Authority Public Key (can update NFT metadata)
# Usually the same as mint authority or a separate cold wallet
# Example: 7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU
UPDATE_AUTHORITY_PUBLIC_KEY=your_update_authority_address_here

# Solana RPC URL
# Get from: https://helius.dev (recommended) or https://quicknode.com
# For testing: https://api.devnet.solana.com
# For production: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://api.devnet.solana.com

# Solana Network (devnet | mainnet-beta)
SOLANA_NETWORK=devnet

# ============================================
# IPFS / PINATA CONFIGURATION
# ============================================

# Pinata API Credentials
# Get from: https://pinata.cloud (Account ’ API Keys)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here

# Pinata Gateway (optional, for faster image loading)
# Example: gateway.pinata.cloud or your custom domain
PINATA_GATEWAY=gateway.pinata.cloud

# ============================================
# DATABASE - SUPABASE
# ============================================

# Supabase Project URL
# Get from: https://supabase.com (Project Settings ’ API)
# Example: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=your_supabase_project_url_here

# Supabase Anon/Public Key (for client-side queries)
# This is safe to expose in frontend code
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (for server-side admin operations)
# KEEP THIS SECRET! Only use in API functions
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ============================================
# RATE LIMITING (Optional - Upstash Redis)
# ============================================

# Upstash Redis for distributed rate limiting
# Get from: https://upstash.com (Create Database ’ REST API)
# Leave empty to use in-memory rate limiting (resets on deploy)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ============================================
# STORE CONFIGURATION
# ============================================

# Royalty Percentage (0-100)
# Percentage of secondary sales that go to creator
ROYALTY_PERCENTAGE=5

# Enable Store (true | false)
# Set to false to temporarily disable minting
STORE_ENABLED=true

# ============================================
# SECURITY (Optional)
# ============================================

# Webhook Secret (for Vercel deploy hooks or payment notifications)
WEBHOOK_SECRET=your_webhook_secret_here

# Admin API Key (for protected admin endpoints)
ADMIN_API_KEY=your_admin_api_key_here

# ============================================
# INSTRUCTIONS FOR SETUP
# ============================================
#
# 1. Create Solana Wallets:
#    solana-keygen new --outfile mint-authority.json
#    solana-keygen new --outfile treasury.json
#    solana-keygen new --outfile update-authority.json
#
# 2. Fund Treasury Wallet:
#    - For devnet: solana airdrop 2 <address> --url devnet
#    - For mainnet: send SOL from exchange
#
# 3. Sign up for Services:
#    - Helius: https://helius.dev (free tier: 100k requests/day)
#    - Pinata: https://pinata.cloud (free tier: 1GB storage)
#    - Supabase: https://supabase.com (free tier: 500MB database)
#
# 4. Set Environment Variables in Vercel:
#    vercel env add MINT_AUTHORITY_PRIVATE_KEY
#    (repeat for each variable)
#
# 5. Test on Devnet First:
#    - Set SOLANA_NETWORK=devnet
#    - Set SOLANA_RPC_URL=https://api.devnet.solana.com
#    - Test full minting flow
#
# 6. Deploy to Production:
#    - Switch to SOLANA_NETWORK=mainnet-beta
#    - Update RPC URL to mainnet Helius endpoint
#    - Redeploy with: vercel --prod
